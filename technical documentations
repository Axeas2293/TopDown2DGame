private SpawnPoint FindSpawnPointByID(string id)
{
    SpawnPoint[] allSpawnPoints = FindObjectsOfType<SpawnPoint>();
    foreach (var sp in allSpawnPoints)
    {
        if (sp.ID == id)
            return sp;
    }
    
    Debug.LogWarning($"SpawnPoint with ID '{id}' not found!");
    return null; // Oder default SpawnPoint?
}
```

**Best Practice:**
